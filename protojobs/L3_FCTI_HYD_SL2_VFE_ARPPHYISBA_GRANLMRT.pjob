
# MITRAILLE PROFILE = medium, TIME = 30

#============================================================
#------------------------------------------------------------
# Configuration 001HYD (forecast)
#  Forecast with physics.
#  Upper-air physics: ARPEGE one.
#  Surface physics: ISBA.
#  Dynamical core: thin-layer hydrostatic model.
#  Advection: SL2TL
#  Vertical discretisation: vertical finite elements (VFE)
#  Initialisation by DFI
#------------------------------------------------------------
#  Domain: ALADIN-GRANLMRT (rotated Mercator projection)
#  Resolution: Dx=20km; 70 vertical levels.
#  Start date: 15 Oct 2011 00TU.
#  Timestep and range: see in namelist.
#------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf 001HYD sl2tl (rot. Mercator GRANLMRT); DFI                                                         

CNMEXPL=L3_FCTI_HYD_SL2_VFE_ARPPHYISBA_GRANLMRT

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
cd $TMP_LOC

MYOWNBIN=__my_own_pack__/bin/MASTERODB

CYCLE='__v_cycle__'
CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

$XPNAM --delta="
&NAMPAR0
  MBX_SIZE=$MBX_SIZE,
  NPROC=$NPROC,
  MP_TYPE=$MP_TYPE,
  LOPT_SCALAR=$LOPT_SCALAR,
/
&NAMPAR1
  NSTRIN=$NPROC,
  NSTROUT=$NPROC,
  NCOMBFLEN=$NCOMBFLEN,
/
" namprovi=${CNMEXPL}.nam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/GRANLMRT_20111015r0_L70bb_INIT ICMSH${CNMEXPS}INIT

# LBC:
for iech in 00 03 06 09 12
do
 case $iech in
   00) icoupl='000' ;;
   03) icoupl='001' ;;
   06) icoupl='002' ;;
   09) icoupl='003' ;;
   12) icoupl='004' ;;
 esac
 $ECP ${FILE_PATH}/GRANLMRT_20111015r0_L70bb_COUPL00${iech}  ELSCF${CNMEXPS}ALBC${icoupl}
done

# Constants for RRTM radiation scheme:
$ECP ${FILE_PATH_RRTMCST}/* .

# Constants for SRTM radiation scheme: not used currently
##neu $ECP ${FILE_PATH_SRTMCST}/* .

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file"
    \cat $file
  done
fi

ls -l

echo "@@ `date`"
