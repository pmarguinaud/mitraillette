
# MITRAILLE PROFILE = half
# MITRAILLE TIME    = 10

#============================================================
#------------------------------------------------------------
# Configuration 001NHE (forecast)
#  Adiabatic forecast
#  Dynamical core: thin-layer compressible non-hydrostatic model.
#  Advection: SL2TL
#  Vertical discretisation: vertical finite differences (VFD)
#  Initialisation by DFI
#  FullPc; GWADV with ND4SYS=2.
#------------------------------------------------------------
#  Resolution: TL030c2.4; 15 vertical levels.
#  Start date: 15 Jul 2005 00TU.
#  Timestep and range: see in namelist.
#------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT = Conf 001NHE sl2tl adiab TL030L15c2.4; DFI; FullPc; GWadv; ND4SYS=2; VFD

CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

getnam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/B0302005071500L.C024.032l.L15.NH ICMSH${CNMEXPS}INIT

# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


shownode
