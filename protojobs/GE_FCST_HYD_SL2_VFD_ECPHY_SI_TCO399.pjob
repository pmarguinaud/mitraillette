
# MITRAILLE PROFILE = small, TIME = 10

#============================================================
#------------------------------------------------------------
# Configuration 001HYD (forecast)
#  IFS forecast with physics.
#  Upper-air physics: ECPHYS
#  Dynamical core: thin-layer hydrostatic model.
#  Advection: SL2TL
#  Vertical discretisation: vertical finite differences (VFD)
#  SI
#  No initialisation
#  IO server off.
#  Standard Legendre transforms.
#------------------------------------------------------------
#  Resolution: cubic-octahedral TCO399; 137 vertical levels.
#  Timestep and range: TSTEP=900.0, CSTOP='h12',
#------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf IFS 001HYD sl2tl diab TCO399; no DFI; VFD; no SLHD                                                 

CNMEXPL=GE_FCST_HYD_SL2_VFD_ECPHY_SI_TCO399

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
cd $TMP_LOC

MYOWNBIN=__my_own_pack__/bin/MASTERODB

CYCLE='__v_cycle__'

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

$XPNAM --delta="
&NAMPAR0
  NPROC=$NPROC,
/
" namprovi=${CNMEXPL}.nam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
IFS_DATA=${FILE_PATH_IFS}
$ECP $IFS_DATA/ICMSHT800INIT                           ICMSHFCSTINIT
$ECP $IFS_DATA/ICMCLT800INIT                           ICMCLFCSTINIT
$ECP $IFS_DATA/ICMGGT800INIUA                          ICMGGFCSTINIUA
$ECP $IFS_DATA/ICMGGT800INIT                           ICMGGFCSTINIT

# Clim data
$ECP $IFS_DATA/399_4                                   399_4

# Constants for RRTM radiation scheme:
$ECP ${FILE_PATH_RRTMCST}/* .

#      ***************
#      *  Execution  *
#      ***************


grib_api_prefix=$(ldd $MYOWNBIN  | perl -ne ' 
 next unless (m/libeccodes_f90/o); 
 my ($path) = (m/=>\s+(\S+)/o); 
 use File::Basename; 
 print &dirname (&dirname ($path)), "\n" ')

export ECCODES_SAMPLES_PATH=$grib_api_prefix/share/eccodes/ifs_samples/grib1_mlgrib2:/MEMFS/ifs_samples/grib1_mlgrib2
export ECCODES_DEFINITION_PATH=$PWD/extra_grib_defs:$grib_api_prefix/share/definitions:$grib_api_prefix/share/eccodes/definitions:/MEMFS/share/definitions:/MEMFS/share/eccodes/definitions

cat << EOF | update_paramId.pl \
  $grib_api_prefix/share/eccodes/definitions/grib2/localConcepts/ecmf/paramId.def \
  - extra_grib_defs/grib2/localConcepts/ecmf/paramId.def
#Time-integrated total column vertically-integrated eastward ozone flux
'233032' = {
         discipline = 0 ; 
         parameterCategory = 20 ;
         parameterNumber = 78 ;
         typeOfFirstFixedSurface = 1 ;
         typeOfSecondFixedSurface = 8 ;
         constituentType = 0 ;
         typeOfStatisticalProcessing = 1 ;
}
#Time-integrated total column vertically-integrated northward ozone flux
'233033' = {
         discipline = 0 ;
         parameterCategory = 20 ;
         parameterNumber = 79 ;
         typeOfFirstFixedSurface = 1 ;
         typeOfSecondFixedSurface = 8 ;
         constituentType = 0 ;
         typeOfStatisticalProcessing = 1 ;
}
#Time-integrated total column vertically-integrated divergence of ozone flux
'233034' = {
         discipline = 0 ;
         parameterCategory = 20 ;
         parameterNumber = 80 ;
         typeOfFirstFixedSurface = 1 ;
         typeOfSecondFixedSurface = 8 ;
         constituentType = 0 ;
         typeOfStatisticalProcessing = 1 ;
}
#Time-integrated total column vertically-integrated net source of ozone
'233035' = {
         discipline = 0 ;
         parameterCategory = 20 ;
         parameterNumber = 81 ;
         typeOfFirstFixedSurface = 1 ;
         typeOfSecondFixedSurface = 8 ;
         constituentType = 0 ;
         typeOfStatisticalProcessing = 1 ;
}
EOF


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file "
    \cat $file
  done
fi

#for iech in 06 12 18 24 30 36 42 48 54 60 66 72 78 84 90 96

ls -l

echo "@@ `date`"
