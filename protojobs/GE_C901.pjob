
# MITRAILLE PROFILE = tiny-manycore
# MITRAILLE TIME    = 10

#============================================================
#------------------------------------------------------------
# Configuration 901 (make ARPEGE file from MARS file)
#------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT = Conf 901

CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

sed \
 -e "s/__NCOMBFLEN__/$NCOMBFLEN/" \
 -e "s/__MP_TYPE__/$MP_TYPE/" \
 -e "s/__LOPT_SCALAR__/$LOPT_SCALAR/" \
 -e "s/__MBX_SIZE__/$MBX_SIZE/" \
 -e "s/__NTASK_IO__/$NPROC_IO/" -e "s/__NTASKS__/$NPROC/" \
${CNMEXPL}.nam > namprovi

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

$ECP ${FILE_PATH}/Const.Clim.m07 Const.Clim
$ECP ${FILE_PATH}/ana.20130710.00.alti_glob.grb ICMGG${CNMEXPS}INIT
$ECP ${FILE_PATH}/ana.20130710.00.alti_st511.grb ICMSH${CNMEXPS}INIT
$ECP ${FILE_PATH}/ana.20130710.00.sol_glob.grb ICMUA${CNMEXPS}INIT
$ECP ${FILE_PATH}/ana.20130710.00.ssol_glob.grb ICMUB${CNMEXPS}INIT

# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4
$CP fort.4 fort.25

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


shownode
