
# MITRAILLE PROFILE = medium
# MITRAILLE TIME    = 10

#============================================================
#------------------------------------------------------------------
# Off-line FULLPOS
#  SPLELAM towards SPLELAM (CFPFMT='MODEL')
#  Adiabatic
#  Dynamical core: thin-layer hydrostatic model.
#  Vertical discretisation: vertical finite differences (VFD)
#------------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT = Conf 903HYD FPOS MOD; LELAM=T; CFPFMT=MODEL; OFF-LINE

CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

getnam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/FRAN_20100115r0_ope_analyse+0003 ICMSH${CNMEXPS}INIT

# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


shownode
