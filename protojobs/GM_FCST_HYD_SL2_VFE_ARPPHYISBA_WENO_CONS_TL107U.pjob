
# MITRAILLE PROFILE = medium, TIME = 20

#============================================================
#------------------------------------------------------------
# Configuration 001HYD 
#  Forecast with isba physics.
#  Dynamical core: thin-layer hydrostatic model.
#  Advection: SL2TL
#  Vertical discretisation: vertical finite elements (VFE)
#  WENO (+ CONS) : LRHSVWENO=.TRUE., LSLTVWENO=.TRUE., LHOISLT=.TRUE., YQ_NL%LQM=.FALSE., YQ_NL%LVWENO=.TRUE.
#                  CLAITRI_WENO_TYPE="VECTOR", LQM3DCONS=.TRUE., YQ_NL%LQM3D=.TRUE.
#  No initialisation
#------------------------------------------------------------
#  Resolution: TL107L70C1; 70 vertical levels.
#  Start date: 18 Jan 2010 00TU.
#  Timestep and range: see in namelist.
#------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf 001HYD sl2tl diab TL107L70c1; no DFI; VFE; no SLHD; WENO and LQM3DCONS=.TRUE.                      

CNMEXPL=GM_FCST_HYD_SL2_VFE_ARPPHYISBA_WENO_CONS_TL107U

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
export TEMPORAIRE=$TMP_LOC
cd $TEMPORAIRE || exit

MYOWNBIN=__my_own_pack__/bin/MASTERODB
[ -n "$MY_PRIORITY_MIT_EXE" ] && MYOWNBIN=$MY_PRIORITY_MIT_EXE
CYCLE='__v_cycle__'
CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

sed \
 -e "s/__NCOMBFLEN__/$NCOMBFLEN/" \
 -e "s/__MP_TYPE__/$MP_TYPE/" \
 -e "s/__LOPT_SCALAR__/$LOPT_SCALAR/" \
 -e "s/__MBX_SIZE__/$MBX_SIZE/" \
 -e "s/__NTASK_IO__/$NPROC_IO/" -e "s/__NTASKS__/$NPROC/" \
${CNMEXPL}.nam > namprovi

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/GB1072010011800L.C010.L70bb.108l ICMSH${CNMEXPS}INIT
$CP ICMSH${CNMEXPS}INIT ICMSH${CNMEXPS}IMIN

# Constants for RRTM radiation scheme:
$ECP ${FILE_PATH_RRTMCST}/* .

# Constants for SRTM radiation scheme: not used currently
##neu $ECP ${FILE_PATH_SRTMCST}/* .

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file "
    \cat $file
  done
fi


#      ***********************************
#      *  Save model results             *
#      ***********************************

echo " Save model results "

# nothing done for the time being

echo " Present files on the workdir $TEMPORAIRE "
ls -l



cd __mitra_home__
echo "@@ `date`"
