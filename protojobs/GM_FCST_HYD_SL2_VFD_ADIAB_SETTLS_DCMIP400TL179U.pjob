
# MITRAILLE PROFILE = small, TIME = 20

#============================================================
#------------------------------------------------------------
# Configuration 001HYD (forecast)
#  Adiabatic forecast
#  Dynamical core: thin-layer hydrostatic model.
#  Advection: SL2TL
#  Vertical discretisation: vertical finite differences (VFD)
#  No initialisation
#  SETTLS
#------------------------------------------------------------
#  Resolution: TL179c1; 31 vertical levels.
#  Academic case DCMIP12-400
#  Timestep and range: see in namelist.
#------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf 001HYD sl2tl adiab DCMIP400 TL179L31c1; no DFI; SETTLS; VFD                                        

CNMEXPL=GM_FCST_HYD_SL2_VFD_ADIAB_SETTLS_DCMIP400TL179U

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
cd $TMP_LOC

MYOWNBIN=__my_own_pack__/bin/MASTERODB

CYCLE='__v_cycle__'
CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

$XPNAM --delta="
&NAMPAR0
  MBX_SIZE=$MBX_SIZE,
  NPROC=$NPROC,
  MP_TYPE=$MP_TYPE,
  LOPT_SCALAR=$LOPT_SCALAR,
/
&NAMPAR1
  NSTRIN=$NPROC,
  NSTROUT=$NPROC,
  NCOMBFLEN=$NCOMBFLEN,
/
" namprovi=${CNMEXPL}.nam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions: none

# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file "
    \cat $file
  done
fi

ls -l

echo "@@ `date`"
