
# MITRAILLE PROFILE = medium
# MITRAILLE TIME    = 30

#============================================================
#------------------------------------------------------------
# Configuration 001NHE (forecast)
#  Forecast with physics.
#  Upper-air physics: ARPEGE one.
#  Surface physics: ISBA.
#  Dynamical core: thin-layer compressible non-hydrostatic model.
#  Advection: SL2TL
#  Vertical discretisation: vertical finite differences (VFD)
#  Initialisation by DFI
#------------------------------------------------------------
#  Domain: ALADIN-GRANLMRT (rotated Mercator projection)
#  Resolution: Dx=20km; 70 vertical levels.
#  Start date: 15 Oct 2011 00TU.
#  Timestep and range: see in namelist.
#------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT = Conf 001NHE sl2tl (rot. Mercator GRANLMRT); DFI

CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

getnam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/GRANLMRT_20111015r0_L70bb.NH_INIT ICMSH${CNMEXPS}INIT

# LBC:
for iech in 00 03 06 09 12
do
 case $iech in
   00) icoupl='000' ;;
   03) icoupl='001' ;;
   06) icoupl='002' ;;
   09) icoupl='003' ;;
   12) icoupl='004' ;;
 esac
 $ECP ${FILE_PATH}/GRANLMRT_20111015r0_L70bb.NH_COUPL00${iech}  ELSCF${CNMEXPS}ALBC${icoupl}
done

# Constants for RRTM radiation scheme:
$ECP ${FILE_PATH_RRTMCST}/* .

# Constants for SRTM radiation scheme: not used currently
##neu $ECP ${FILE_PATH_SRTMCST}/* .

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


shownode
