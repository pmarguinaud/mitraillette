
# MITRAILLE PROFILE = medium, TIME = 10

#============================================================
#------------------------------------------------------------------
# Off-line FULLPOS
#  SPLELAM towards GPLALON
#  Upper air physics: cf. ARPEGE one.
#  Surface physics: ISBA.
#  Dynamical core: thin-layer hydrostatic model.
#  Vertical discretisation: vertical finite differences (VFD)
#------------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf 001HYD FPOS OPE2; LELAM=T; CFPFMT=LALON; OFF-LINE                                                  

CNMEXPL=L3_FPOF_HYD_GPLALON_OPE2_ARPPHYISBA

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
cd $TMP_LOC

MYOWNBIN=__my_own_pack__/bin/MASTERODB

CYCLE='__v_cycle__'
CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

$XPNAM --delta="
&NAMPAR0
  MBX_SIZE=$MBX_SIZE,
  NPROC=$NPROC,
  MP_TYPE=$MP_TYPE,
  LOPT_SCALAR=$LOPT_SCALAR,
/
&NAMPAR1
  NSTRIN=$NPROC,
  NSTROUT=$NPROC,
  NCOMBFLEN=$NCOMBFLEN,
/
" namprovi=${CNMEXPL}.nam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions + clims:
$ECP ${FILE_PATH}/FRAN_20100115r0_ope_analyse+0003 ICMSH${CNMEXPS}INIT
$ECP ${FILE_PATH}/clim_france.09km51.14.m01 Const.Clim
$ECP ${FILE_PATH}/clim_dap.franx01.10.m01 const.clim.FRANX01

# Constants for RRTM radiation scheme:
$ECP ${FILE_PATH_RRTMCST}/* .

# Constants for SRTM radiation scheme: not used currently
##neu $ECP ${FILE_PATH_SRTMCST}/* .

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4
$CP namprovi xxt00000000
/bin/ls > dirlst

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file"
    \cat $file
  done
fi

ls -l

echo "@@ `date`"
