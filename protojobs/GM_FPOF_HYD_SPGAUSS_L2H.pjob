
# MITRAILLE PROFILE = medium, TIME = 10

#============================================================
#------------------------------------------------------------------
# Off-line FULLPOS
#  SCRIPT TO TRANSFORM ARPEGE TL107C10L70 towards TL798C24L70 (L2H)
#  Adiabatic
#  SPGAUSS towards SPGAUSS
#  Dynamical core: thin-layer hydrostatic model.
#  Vertical discretisation: vertical finite differences (VFD)
#------------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf 001HYD FPOS L2H; CFPFMT=GAUSS; OFF-LINE                                                            

CNMEXPL=GM_FPOF_HYD_SPGAUSS_L2H

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
cd $TMP_LOC

MYOWNBIN=__my_own_pack__/bin/MASTERODB

CYCLE='__v_cycle__'
CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

$XPNAM --delta="
&NAMPAR0
  MBX_SIZE=$MBX_SIZE,
  NPROC=$NPROC,
  MP_TYPE=$MP_TYPE,
  LOPT_SCALAR=$LOPT_SCALAR,
/
&NAMPAR1
  NSTRIN=$NPROC,
  NSTROUT=$NPROC,
  NCOMBFLEN=$NCOMBFLEN,
/
" namprovi=${CNMEXPL}.nam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/GB1072010011800L.C010.L70bb.108l ICMSH${CNMEXPS}INIT

# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none

# Departure climatologies:
$ECP ${FILE_PATH}/clim_arpege.tl107.12.m01 Const.Clim

# Arrival climatologies:
$ECP ${FILE_PATH}/clim_arpege.tl798.01.m01 const.clim.000

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file "
    \cat $file
  done
fi

ls -l

echo "@@ `date`"
