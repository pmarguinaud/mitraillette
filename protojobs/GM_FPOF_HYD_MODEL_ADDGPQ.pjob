
# MITRAILLE PROFILE = small, TIME = 10

#============================================================
#------------------------------------------------------------------------
# Off-line FULLPOS
#  SPGAUSS towards SPGAUSS (CFPFMT='MODEL')
#  Adiabatic
#  Dynamical core: thin-layer hydrostatic model.
#  Replaces spectral "q" by grid-point "q".
#------------------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf 001HYD FPOS; CFPFMT='MODEL'; add grid-point q; OFF-LINE                                            

CNMEXPL=GM_FPOF_HYD_MODEL_ADDGPQ

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
export TEMPORAIRE=$TMP_LOC
cd $TEMPORAIRE || exit

MYOWNBIN=__my_own_pack__/bin/MASTERODB

CYCLE='__v_cycle__'
CNMEXPS="ARPE"

idate=2005071500
insmaxa=031 # sur 3 chiffres minimum
indgl=032   # sur 3 chiffres minimum
indlon=064  # sur 3 chiffres minimum
inflevg=70bb
inflevgfin=70bb
instret=010

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

sed \
 -e "s/__NCOMBFLEN__/$NCOMBFLEN/" \
 -e "s/__MP_TYPE__/$MP_TYPE/" \
 -e "s/__LOPT_SCALAR__/$LOPT_SCALAR/" \
 -e "s/__MBX_SIZE__/$MBX_SIZE/" \
 -e "s/__NTASK_IO__/$NPROC_IO/" -e "s/__NTASKS__/$NPROC/" \
${CNMEXPL}.nam > namprovi

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/B${insmaxa}${idate}L.C${instret}.${indgl}l.L${inflevg} ICMSH${CNMEXPS}INIT
$CP ICMSH${CNMEXPS}INIT PF${CNMEXPS}000+0000

# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none

# Departure and arrival climatologies: none

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file "
    \cat $file
  done
fi


#      ***********************************
#      *  Save model results             *
#      ***********************************

echo " Save model results "

# Post-processing files:
$CP PF${CNMEXPS}000+0000 ${FILE_PATH}/B${insmaxa}${idate}M.C${instret}.${indgl}l.L${inflevgfin}

echo " Present files on the workdir $TEMPORAIRE "
ls -l



cd __mitra_home__
echo "@@ `date`"
