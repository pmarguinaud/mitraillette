
# MITRAILLE PROFILE = small, TIME = 10

#============================================================
#------------------------------------------------------------
# Configuration 001HYD (forecast)
#  Adiabatic forecast
#  Dynamical core: thin-layer hydrostatic model.
#  Advection: SL2TL
#  Vertical discretisation: vertical finite differences (VFD)
#  No initialisation
#  SETTLS extrapolation; XIDT; RW2TLFF=1.
#------------------------------------------------------------
#  Resolution: TL030c2.4; 15 vertical levels.
#  Start date: 15 Jul 2005 00TU.
#  Timestep and range: see in namelist.
#------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf 001HYD sl2tl adiab TL030L15c2.4; no DFI; SETTLS; XIDT; VFD; RW2TLFF=1                              

CNMEXPL=GM_FCST_HYD_SL2_VFD_ADIAB_SETTLS_XIDT_RW2TLFF_TL030S

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
export TEMPORAIRE=$TMP_LOC
cd $TEMPORAIRE || exit

MYOWNBIN=__my_own_pack__/bin/MASTERODB
[ -n "$MY_PRIORITY_MIT_EXE" ] && MYOWNBIN=$MY_PRIORITY_MIT_EXE
CYCLE='__v_cycle__'
CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

sed \
 -e "s/__NCOMBFLEN__/$NCOMBFLEN/" \
 -e "s/__MP_TYPE__/$MP_TYPE/" \
 -e "s/__LOPT_SCALAR__/$LOPT_SCALAR/" \
 -e "s/__MBX_SIZE__/$MBX_SIZE/" \
 -e "s/__NTASK_IO__/$NPROC_IO/" -e "s/__NTASKS__/$NPROC/" \
${CNMEXPL}.nam > namprovi

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/B0302005071500L.C024.032l.L15 ICMSH${CNMEXPS}INIT

# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file "
    \cat $file
  done
fi


#      ***********************************
#      *  Save model results             *
#      ***********************************

echo " Save model results "

# nothing done for the time being

echo " Present files on the workdir $TEMPORAIRE "
ls -l



cd __mitra_home__
echo "@@ `date`"
