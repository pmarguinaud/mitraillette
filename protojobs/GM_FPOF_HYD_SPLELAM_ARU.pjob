
# MITRAILLE PROFILE = medium
# MITRAILLE TIME    = 10

#============================================================
#------------------------------------------------------------
# Off-line FULLPOS
#  SCRIPT TO GET COUPLING ARPEGE - AROME for upper-air fields
#  Complete AROME physics
#  SPGAUSS towards SPLELAM
#  Dynamical core: thin-layer hydrostatic model.
#  Vertical discretisation: vertical finite differences (VFD)
#------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT = Conf 001HYD FPOS; E927-NFPOS2 ARU; OFF-LINE

CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

getnam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

$ECP ${FILE_PATH}/F7982011011312L.C024.L70bb.operprod ICMSH${CNMEXPS}INIT
$ECP ${FILE_PATH}/clim_arpege.tl798.02.m01 Const.Clim
$ECP ${FILE_PATH}/clim_arome.m01 const.clim.FRANGP

# Constants for RRTM radiation scheme:
$ECP ${FILE_PATH_RRTMCST}/* .

# Constants for SRTM radiation scheme: not used currently
##neu $ECP ${FILE_PATH_SRTMCST}/* .

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


shownode
