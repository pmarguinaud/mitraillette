
# MITRAILLE PROFILE = tiny-manycore, TIME = 10

#==================================================================
#------------------------------------------------------------------
# Configuration 001HYD (forecast)
#  Forecast with AROME physics adapted to 1D model (SURFEX)
#  Dynamical core: thin-layer hydrostatic model.
#  Advection: SL2TL
#  Vertical discretisation: vertical finite differences (VFD)
#  No initialisation
#------------------------------------------------------------------
#  Domain: 1D model (column)
#  Resolution: 79 vertical levels.
#  Timestep and range: see in namelist.
#------------------------------------------------------------------
#==================================================================

# MITRAILLE COMMENT: Conf 001HYD-1D sl2tl with AROME physics; VFD                                                            

CNMEXPL=L1_FCST_HYD_SL2_VFD_AROPHY1D

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
cd $TMP_LOC

MYOWNBIN=__my_own_pack__/bin/MASTERODB

CYCLE='__v_cycle__'
CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

$CP ${NAM_PATH}/${CNMEXPL}.selnam_exseg1 EXSEG1.nam

$XPNAM --delta="
&NAMPAR0
  MBX_SIZE=$MBX_SIZE,
  NPROC=$NPROC,
  MP_TYPE=$MP_TYPE,
  LOPT_SCALAR=$LOPT_SCALAR,
/
&NAMPAR1
  NSTRIN=$NPROC,
  NSTROUT=$NPROC,
  NCOMBFLEN=$NCOMBFLEN,
/
" namprovi=${CNMEXPL}.nam

\cat < namprovi
\cat < EXSEG1.nam

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/FILE1D_ARMCU_L79_ARO ICMSH${CNMEXPS}INIT

# LBC: none

# Additional Files for SURFEX: none

# Constants for RRTM radiation scheme:
$ECP ${FILE_PATH_RRTMCST}/* .

# Constants for SRTM radiation scheme: not used currently
##neu $ECP ${FILE_PATH_SRTMCST}/* .

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file"
    \cat $file
  done
fi

if [ -a OUTPUT_LISTING ]
then
  echo " Expand file OUTPUT_LISTING "
  \cat OUTPUT_LISTING
fi

ls -l

echo "@@ `date`"
