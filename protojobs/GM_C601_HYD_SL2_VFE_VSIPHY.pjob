
# MITRAILLE PROFILE = small
# MITRAILLE TIME    = 10

#============================================================
#------------------------------------------------------------
# Configuration 601HYD (Computation of first singular vector)
#  Forecast with very simplified physics
#  Dynamical core: thin-layer hydrostatic model.
#  Advection: SL2TL
#  Vertical discretisation: vertical finite elements (VFE)
#  No initialisation
#------------------------------------------------------------
#  Resolution: TL31L15C1; 15 vertical levels.
#  Start date: 15 Jul 2005 00TU.
#  Timestep and range: see in namelist.
#------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT = Conf 601HYD sl2tl with very simplified physics; no DFI; VFE; no SLHD

CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

getnam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/B0312005071500L.C010.032l.L15 ICMSH${CNMEXPS}INIT
$CP ICMSH${CNMEXPS}INIT ICMSH${CNMEXPS}IMIN

# Constants for RRTM radiation scheme:
$ECP ${FILE_PATH_RRTMCST}/* .

# Constants for SRTM radiation scheme: not used currently
##neu $ECP ${FILE_PATH_SRTMCST}/* .

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


shownode
