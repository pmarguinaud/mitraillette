
# MITRAILLE PROFILE = tiny-manycore, TIME = 10

#============================================================
#------------------------------------------------------------------------
# Configuration 001NHE (forecast)
#  Adiabatic forecast
#  Dynamical core: thin-layer (fully compressible) non-hydrostatic model.
#  Advection: SL3TL
#  Vertical discretisation: vertical finite differences (VFD)
#  No initialisation
#------------------------------------------------------------------------
#  Domain: 2D model
#  Resolution: Dx=20m; 39 vertical levels.
#  Timestep and range: see in namelist.
#------------------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf 001NHE-2D sl3tl; no DFI; SI; VFD                                                                   

CNMEXPL=L2_FCST_NHE_SL3_VFD_ADIAB

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
cd $TMP_LOC

MYOWNBIN=__my_own_pack__/bin/MASTERODB

CYCLE='__v_cycle__'
CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

$XPNAM --delta="
&NAMPAR0
  MBX_SIZE=$MBX_SIZE,
  NPROC=$NPROC,
  MP_TYPE=$MP_TYPE,
  LOPT_SCALAR=$LOPT_SCALAR,
/
&NAMPAR1
  NSTRIN=$NPROC,
  NSTROUT=$NPROC,
  NCOMBFLEN=$NCOMBFLEN,
/
" namprovi=${CNMEXPL}.nam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/DOM2D_L039_20070131r0_INIT ICMSH${CNMEXPS}INIT

# LBC:
$ECP ${FILE_PATH}/DOM2D_L039_20070131r0_INIT ELSCF${CNMEXPS}ALBC000
$ECP ${FILE_PATH}/DOM2D_L039_20070131r0_INIT ELSCF${CNMEXPS}ALBC001

# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file"
    \cat $file
  done
fi

ls -l

echo "@@ `date`"
