
# MITRAILLE PROFILE = medium
# MITRAILLE TIME    = 10

#============================================================
#------------------------------------------------------------------
# Off-line FULLPOS
#  SCRIPT TO TRANSFORM ARPEGE TL798C24L70 towards TL107C10L70 (H2L)
#  Adiabatic
#  SPGAUSS towards SPGAUSS
#  Dynamical core: thin-layer hydrostatic model.
#  Vertical discretisation: vertical finite differences (VFD)
#------------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT = Conf 001HYD FPOS H2L; CFPFMT=GAUSS; OFF-LINE

CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

getnam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/F7982010011800L.C024.L70bb.operassim ICMSH${CNMEXPS}INIT

# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none

# Departure climatologies:
$ECP ${FILE_PATH}/clim_arpege.tl798.01.m01 Const.Clim

# Arrival climatologies:
$ECP ${FILE_PATH}/clim_arpege.tl107.12.m01 const.clim.000

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


shownode
