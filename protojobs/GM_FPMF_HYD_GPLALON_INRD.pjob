
# MITRAILLE PROFILE = medium, TIME = 10

#============================================================
#------------------------------------------------------------------------
# Off-line FULLPOS
#  SPGAUSS towards GPLALON
#  Make filtering matrices for several LALON domains via FULLPOS setup
#  Input dilatation-contraction matrices are provided
#------------------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf 001HYD FPOS (makes filtering matrices; input RD matrices); CFPFMT=LALON; OFF-LINE                  

CNMEXPL=GM_FPMF_HYD_GPLALON_INRD

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
cd $TMP_LOC

MYOWNBIN=__my_own_pack__/bin/MASTERODB

CYCLE='__v_cycle__'
CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

$XPNAM --delta="
&NAMPAR0
  MBX_SIZE=$MBX_SIZE,
  NPROC=$NPROC,
  MP_TYPE=$MP_TYPE,
  LOPT_SCALAR=$LOPT_SCALAR,
/
&NAMPAR1
  NSTRIN=$NPROC,
  NSTROUT=$NPROC,
  NCOMBFLEN=$NCOMBFLEN,
/
" namprovi=${CNMEXPL}.nam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions: none
# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none

# Dilatation/contraction matrices:
$ECP ${FILE_PATH_DILA}/MDI7982047C024 MATDILA
$ECP ${FILE_PATH_DILA}/MCO7982047C024 MATCONT

# Departure climatologies: none

# Arrival climatologies:
$ECP ${FILE_PATH}/clim_dap.glob25.07.m01 const.clim.GLOB25
$ECP ${FILE_PATH}/clim_dap.glob15.07.m01 const.clim.GLOB15
$ECP ${FILE_PATH}/clim_dap.glob05.07.m01 const.clim.GLOB05
$ECP ${FILE_PATH}/clim_dap.euroc25.08.m01 const.clim.EUROC25
$ECP ${FILE_PATH}/clim_dap.eurat01.01.m01 const.clim.EURAT01

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file "
    \cat $file
  done
fi

# Filtering matrices:

ls -l

echo "@@ `date`"
