
# MITRAILLE PROFILE = small
# MITRAILLE TIME    = 10

#============================================================
#------------------------------------------------------------------
# Off-line FULLPOS
#  SPGAUSS towards SPLELAM C+I+E
#  Adiabatic
#  Dynamical core: thin-layer hydrostatic model.
#  Vertical discretisation: vertical finite differences (VFD)
#------------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT = Conf 903HYD FPOS; LAM2=E927; LELAM=F; CFPFMT=LELAM; C+I+E; OFF-LINE

CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

getnam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/B0312005071500L.C010.032l.L70bb ICMSH${CNMEXPS}INIT

# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


shownode
