# MITRAILLE COMMENT: Make reduced Gaussian grids                                                                             

CNMEXPL=GM_RGRI

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
cd $TMP_LOC

MYOWNBIN=__my_own_pack__/bin/MASTERODB

CYCLE='__v_cycle__'

NSMAX=1295
NDGLG=1296
NDLON=2592
NN=0        # 0=even numbers only; 1=allow odd numbers
NORTO=12    # orthogonality

#       **********************************
#       *  Get the namelist              *
#       **********************************

## Currently no namelist for this task

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************
#      None for this configuration


#      ***************
#      *  Execution  *
#      ***************


echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file "
    \cat $file
  done
fi

if [ -a fort.20 ]
then
  for file in fort.20
  do
    echo " Expand file $file "
    \cat $file
  done
fi


#      ******************************************************
#      *  Save results                                      *
#      ******************************************************
#      None for this configuration

ls -l

echo "@@ `date`"
