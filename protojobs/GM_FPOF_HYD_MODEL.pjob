
# MITRAILLE PROFILE = medium, TIME = 10

#============================================================
#------------------------------------------------------------------
# Off-line FULLPOS
#  SPGAUSS towards SPGAUSS (CFPFMT='MODEL')
#  Adiabatic
#  Dynamical core: thin-layer hydrostatic model.
#------------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf 903HYD FPOS; CFPFMT=MODEL; OFF-LINE                                                                

CNMEXPL=GM_FPOF_HYD_MODEL

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
export TEMPORAIRE=$TMP_LOC
cd $TEMPORAIRE || exit

MYOWNBIN=__my_own_pack__/bin/MASTERODB
[ -n "$MY_PRIORITY_MIT_EXE" ] && MYOWNBIN=$MY_PRIORITY_MIT_EXE
CYCLE='__v_cycle__'
CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

sed \
 -e "s/__NCOMBFLEN__/$NCOMBFLEN/" \
 -e "s/__MP_TYPE__/$MP_TYPE/" \
 -e "s/__LOPT_SCALAR__/$LOPT_SCALAR/" \
 -e "s/__MBX_SIZE__/$MBX_SIZE/" \
 -e "s/__NTASK_IO__/$NPROC_IO/" -e "s/__NTASKS__/$NPROC/" \
${CNMEXPL}.nam > namprovi

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/F7982010011800L.C024.L70bb.operassim ICMSH${CNMEXPS}INIT

# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none
# Departure climatologies: none
# Arrival climatologies: none

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file "
    \cat $file
  done
fi


#      ***********************************
#      *  Save model results             *
#      ***********************************

echo " Save model results "

OUTNAME="${CNMEXPL}"

# Post-processing files:
$CP PF${CNMEXPS}000+0000 ${WORKDIR}/OUTPUT_FILES/${CYCLE}/mitraille___mitra_pid__/${OUTNAME}__PF${CNMEXPS}000+0000

echo " Present files on the workdir $TEMPORAIRE "
ls -l



cd __mitra_home__
echo "@@ `date`"
