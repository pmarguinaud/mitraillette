
# MITRAILLE PROFILE = small, TIME = 10

#============================================================
#------------------------------------------------------------------------
# Configuration 001NHQ (forecast)
#  Adiabatic forecast
#  Dynamical core: thin-layer (quasi-compressible) non-hydrostatic model.
#  Advection: SL2TL
#  Vertical discretisation: vertical finite differences (VFD)
#  Initialisation by DFI
#  LGWADV=T; ND4SYS=2; FullPC
#------------------------------------------------------------------------
#  Domain: ALADIN-SOUTHERN-FRANCE
#  Resolution: Dx=4.415km; 15 vertical levels.
#  Start date: 14 Jun 2001 00TU.
#  Timestep and range: see in namelist.
#------------------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf 001NHQ sl2tl; DFI; FullPC; GWadv; ND4SYS=2; VFD                                                    

CNMEXPL=L3_FCTI_NHQ_SL2_VFD_ADIAB_GWADV2_PCF_FROC

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
export TEMPORAIRE=$TMP_LOC
cd $TEMPORAIRE || exit

MYOWNBIN=__my_own_pack__/bin/MASTERODB
[ -n "$MY_PRIORITY_MIT_EXE" ] && MYOWNBIN=$MY_PRIORITY_MIT_EXE
CYCLE='__v_cycle__'
CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

sed \
 -e "s/__NCOMBFLEN__/$NCOMBFLEN/" \
 -e "s/__MP_TYPE__/$MP_TYPE/" \
 -e "s/__LOPT_SCALAR__/$LOPT_SCALAR/" \
 -e "s/__MBX_SIZE__/$MBX_SIZE/" \
 -e "s/__NTASK_IO__/$NPROC_IO/" -e "s/__NTASKS__/$NPROC/" \
${CNMEXPL}.nam > namprovi

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/FROC_20010614r0_L15.NH_INIT ICMSH${CNMEXPS}INIT

# LBC:
$ECP ${FILE_PATH}/FROC_20010614r0_L15.NH_COUPL0000 ELSCF${CNMEXPS}ALBC000
$ECP ${FILE_PATH}/FROC_20010614r0_L15.NH_COUPL0003 ELSCF${CNMEXPS}ALBC001

# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file"
    \cat $file
  done
fi


#      ***********************************
#      *  Save model results             *
#      ***********************************

echo " Save model results "

OUTNAME="${CNMEXPL}"
##neu for iech in 0003
##neu do
##neu   $CP ICMSH${CNMEXPS}+${iech} ${WORKDIR}/OUTPUT_FILES/${CYCLE}/mitraille___mitra_pid__/${OUTNAME}__ech${iech}.HIST
##neu done

echo " Present files on the workdir $TEMPORAIRE "
ls -l



cd __mitra_home__
echo "@@ `date`"
