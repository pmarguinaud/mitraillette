
# MITRAILLE PROFILE = tiny-manycore, TIME = 10

#============================================================
#------------------------------------------------------------
# Configuration 001HYD (forecast)
#  Adiabatic forecast
#  Dynamical core: thin-layer hydrostatic model.
#  Advection: SL3TL
#  Vertical discretisation: vertical finite differences (VFD)
#  Initialisation by DFI
#------------------------------------------------------------
#  Domain: 2D model
#  Resolution: Dx=3.2km; 20 vertical levels.
#  Timestep and range: see in namelist.
#------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf 001HYD-2D sl3tl; DFI; VFD                                                                          

CNMEXPL=L2_FCTI_HYD_SL3_VFD_ADIAB

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
cd $TMP_LOC

MYOWNBIN=__my_own_pack__/bin/MASTERODB

CYCLE='__v_cycle__'
CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

sed \
 -e "s/__NCOMBFLEN__/$NCOMBFLEN/" \
 -e "s/__MP_TYPE__/$MP_TYPE/" \
 -e "s/__LOPT_SCALAR__/$LOPT_SCALAR/" \
 -e "s/__MBX_SIZE__/$MBX_SIZE/" \
 -e "s/__NTASK_IO__/$NPROC_IO/" -e "s/__NTASKS__/$NPROC/" \
${CNMEXPL}.nam > namprovi

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

# Initial conditions:
$ECP ${FILE_PATH}/DOM2D_L020_19980101r0_INIT ICMSH${CNMEXPS}INIT

# LBC:
$ECP ${FILE_PATH}/DOM2D_L020_19980101r0_INIT ELSCF${CNMEXPS}ALBC000
$ECP ${FILE_PATH}/DOM2D_L020_19980101r0_INIT ELSCF${CNMEXPS}ALBC001

# Constants for RRTM radiation scheme: none
# Constants for SRTM radiation scheme: none

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file"
    \cat $file
  done
fi


#      ***********************************
#      *  Save model results             *
#      ***********************************

echo " Save model results "

OUTNAME="${CNMEXPL}"
for echc in 0100 0200
do
  $CP ICMSH${CNMEXPS}+${echc}  ${WORKDIR}/OUTPUT_FILES/${CYCLE}/mitraille___mitra_pid__/${OUTNAME}__ech${echc}.HIST
done

ls -l



echo "@@ `date`"
