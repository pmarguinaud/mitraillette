
# MITRAILLE PROFILE = medium, TIME = 10

#============================================================
#------------------------------------------------------------
# Off-line FULLPOS
#  SCRIPT TO NESTING AROME - AROME
#  Adiabatic
#  SPLELAM towards SPLELAM (former ALADIN-FRANCE)
#  Dynamical core: thin-layer hydrostatic model.
#  Vertical discretisation: vertical finite differences (VFD)
#------------------------------------------------------------
#============================================================

# MITRAILLE COMMENT: Conf 001HYD EE927-NFPOS2 ARUNES                                                                         

CNMEXPL=L3_FPOF_HYD_SPLELAM_ARUNES

TEMPLATE=$CNMEXPL
echo TEMPLATE=$TEMPLATE

echo "@@ `date`"

# Move on a workspace.
cd $TMP_LOC

MYOWNBIN=__my_own_pack__/bin/MASTERODB

CYCLE='__v_cycle__'
CNMEXPS="ARPE"

#       **********************************
#       *  Get the namelist              *
#       **********************************

echo " Get the namelist "

VERSION=`echo $CYCLE | tr [A-Z] [a-z]`
echo $VERSION
NAM_PATH=__nam_path__
$CP ${NAM_PATH}/${CNMEXPL}.nam ${CNMEXPL}.nam

$XPNAM --delta="
&NAMPAR0
  MBX_SIZE=$MBX_SIZE,
  NPROC=$NPROC,
  MP_TYPE=$MP_TYPE,
  LOPT_SCALAR=$LOPT_SCALAR,
/
&NAMPAR1
  NSTRIN=$NPROC,
  NSTROUT=$NPROC,
  NCOMBFLEN=$NCOMBFLEN,
/
" namprovi=${CNMEXPL}.nam

\cat < namprovi

#      *****************************************************
#      *  Get input files.                                 *
#      *****************************************************

echo " Get input files "

$ECP ${FILE_PATH}/AROM_20110113r12_INIT ICMSH${CNMEXPS}INIT
$ECP ${FILE_PATH}/clim_arome.m01 Const.Clim
$ECP ${FILE_PATH}/clim_arome_pyr500.m01 const.clim.pyr500

# Constants for RRTM radiation scheme:
$ECP ${FILE_PATH_RRTMCST}/* .

# Constants for SRTM radiation scheme: not used currently
##neu $ECP ${FILE_PATH_SRTMCST}/* .

#      ***************
#      *  Execution  *
#      ***************


echo " Copy namelist on fort.4 "
$CP namprovi fort.4

echo " Job running "

mpilaunch $MYOWNBIN

ls -l


if [ -a NODE.001_01 ]
then
  for file in NODE*
  do
    echo " Expand file $file"
    \cat $file
  done
fi

ls -l

echo "@@ `date`"
